{
  "manifest_version": 3,
  "name": "History for Spotify Web",
  "short_name": "History",
  "version": "0.3.0",
  "description": "Find tracks you played in Spotify's web player. Search local history, copy links, and add songs back to your queue.",
  "minimum_chrome_version": "114",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://open.spotify.com/*"
      ],
      "js": [
        "history.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN",
      "all_frames": false
    }
  ],
  "homepage_url": "https://github.com/demetriusk/history-for-spotify-web"
}
