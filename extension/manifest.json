{
  "manifest_version": 3,
  "name": "History for Spotify Web",
  "short_name": "History",
  "version": "0.3.2",
  "description": "__MSG_extensionDescription__",
  "minimum_chrome_version": "114",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://open.spotify.com/*"
      ],
      "js": [
        "history.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN",
      "all_frames": false
    }
  ],
  "homepage_url": "https://github.com/demetriusk/history-for-spotify-web",
  "permissions": [
    "scripting"
  ],
  "host_permissions": [
    "https://open.spotify.com/*"
  ],
  "action": {
    "default_title": "History for Spotify Web",
    "default_icon": {
      "16": "icons/toolbar-16.png",
      "24": "icons/toolbar-24.png",
      "32": "icons/toolbar-32.png"
    },
    "default_popup": "popup.html"
  },
  "default_locale": "en"
}
